{
  "name": "resumex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prisma-migrate-deploy.cjs && next build",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:pubmed:live": "vitest run lib/talent-mapper/providers/pubmed/__tests__/pubmed.live.test.ts",
    "test:e2e:career": "node scripts/e2e-career.mjs",
    "test:e2e:talent-mapper": "node scripts/e2e-talent-mapper.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.9.0",
    "@vercel/blob": "^2.5.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.10.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "openai": "^6.42.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
