generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  email            String?
  passwordHash     String
  createdAt        DateTime       @default(now())
  stripeCustomerId String?        @unique
  isPro            Boolean        @default(false)
  applications     Application[]
  profile          Profile?
  answers          Answer[]
  talentSearches   TalentSearch[]
  usageEvents      UsageEvent[]
  atsConnections   AtsConnection[]
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([userId, name, createdAt])
}

model Application {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    String
  role       String
  jobUrl     String?
  status     String   @default("Applied")
  matchScore Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Composite, not just [userId]: the tracker list filters by userId and sorts
  // by createdAt desc, so this serves the WHERE and the ORDER BY together.
  @@index([userId, createdAt])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  phone        String?
  location     String?
  linkedinUrl  String?
  resumeText   String?
  resumePdfUrl String?
  profileJson  String?
  updatedAt    DateTime @updatedAt
}

model Answer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same shape as Application: AutoApply lists answers by user, ordered by
  // createdAt asc. The per-question lookup narrows on userId from here rather
  // than indexing `question`, which is free-form text.
  @@index([userId, createdAt])
}

// Talent Mapper search owned by a single user (R-010 / T-4.1).
// No Organization yet — team ownership deferred until a real hiring team needs it.
// resultJson is a full immutable snapshot of TalentSearchResult.
model TalentSearch {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle      String
  jobDescription String          @default("")
  criteriaJson   Json
  queriesJson    Json
  mode           String
  resultJson     Json?
  worksReviewed  Int             @default(0)
  uiStep         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shortlist      ShortlistEntry[]
  notes          CandidateNote[]

  @@index([userId, updatedAt])
}

model ShortlistEntry {
  id       String       @id @default(cuid())
  searchId String
  search   TalentSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  authorId String
  addedAt  DateTime     @default(now())

  @@unique([searchId, authorId])
  @@index([searchId])
}

model CandidateNote {
  id        String       @id @default(cuid())
  searchId  String
  search    TalentSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  updatedAt DateTime     @updatedAt

  @@unique([searchId, authorId])
  @@index([searchId])
}

// ─── ATS integrations (ResumeX Talent) ───────────────────────────────────────
// Ownership is per-user until an Organization model exists (R-010 / Fase 10).
// Credentials are AES-256-GCM encrypted; never store plaintext tokens.

enum AtsProvider {
  RECRUITEE
  ZOHO_RECRUIT
  ASHBY
}

enum AtsConnectionMode {
  LIVE
  SANDBOX
  DEMO
}

enum AtsConnectionStatus {
  CONNECTED
  NEEDS_REAUTHENTICATION
  PERMISSION_ERROR
  CONFIGURATION_ERROR
  TEMPORARILY_UNAVAILABLE
  DISCONNECTED
}

model AtsConnection {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider             AtsProvider
  mode                 AtsConnectionMode
  displayName          String
  status               AtsConnectionStatus

  encryptedCredentials String?
  encryptionKeyVersion Int                 @default(1)

  /// Non-secret provider configuration only (company id, DC, field maps, …).
  metadata             Json?
  capabilities         Json?

  lastTestedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  mappings             AtsExternalMapping[]
  transfers            AtsTransfer[]
  webhookEvents        AtsWebhookEvent[]
  oauthStates          AtsOauthState[]

  @@index([userId, provider])
  @@index([provider])
  @@index([status])
}

model AtsExternalMapping {
  id                 String        @id @default(cuid())
  connectionId       String
  connection         AtsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  localEntityType    String
  localEntityId      String
  externalEntityType String
  externalEntityId   String
  externalUrl        String?
  metadata           Json?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([connectionId, localEntityType, localEntityId, externalEntityType])
  @@index([connectionId, externalEntityId])
}

model AtsTransfer {
  id                    String        @id @default(cuid())
  connectionId          String
  connection            AtsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  localCandidateKey     String
  localSearchProjectId  String?
  externalJobId         String

  idempotencyKey        String
  status                String

  candidateSnapshot     Json
  requestSummary        Json
  resultSummary         Json?

  externalCandidateId   String?
  externalApplicationId String?

  completedOperations   Json?
  failedOperation       String?

  errorCode             String?
  safeErrorMessage      String?

  confirmedByUserId     String?
  confirmedAt           DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, localCandidateKey])
}

model AtsWebhookEvent {
  id               String        @id @default(cuid())
  connectionId     String
  connection       AtsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  providerEventId  String
  eventType        String
  payloadHash      String

  status           String
  receivedAt       DateTime      @default(now())
  processedAt      DateTime?
  safeErrorMessage String?

  @@unique([connectionId, providerEventId])
  @@index([connectionId, receivedAt])
}

/// Short-lived Zoho OAuth state (server-side; not a cookie-only store).
model AtsOauthState {
  id           String         @id @default(cuid())
  userId       String
  provider     AtsProvider
  nonce        String         @unique
  connectionId String?
  connection   AtsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  redirectTo   String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([userId, provider])
  @@index([expiresAt])
}
