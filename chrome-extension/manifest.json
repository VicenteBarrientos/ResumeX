{
  "manifest_version": 3,
  "name": "ResumeX AutoApply",
  "version": "1.0.1",
  "description": "Auto-save jobs and see your match score on any job page.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://resumex.talentxrecruiting.com/*",
    "https://*.lever.co/*",
    "https://*.greenhouse.io/*",
    "https://www.linkedin.com/jobs/*",
    "https://www.indeed.com/*",
    "https://*.workday.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ResumeX"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://*.workday.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
