# Copy this file to .env.local for Next.js.
# Prisma CLI reads .env by default, so also keep DATABASE_URL available there
# when running prisma validate/migrate commands locally.

# Required: PostgreSQL connection string, for example Neon or Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required for NextAuth sessions and extension JWT signing.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Required for analyzer, formatter, cover letter, profile parsing, match score, and Talent Mapper AI helpers.
OPENAI_API_KEY="sk-your-openai-api-key-here"
# Optional model override (defaults to gpt-4o-mini in app code).
OPENAI_MODEL=""

# Optional: Talent Mapper live OpenAlex search (server-side only). Without this key, Demo snapshot mode is used.
# Free key: https://openalex.org/settings/api
OPENALEX_API_KEY=""
# Optional polite contact for OpenAlex requests (used alongside the API key when set).
OPENALEX_MAILTO=""

# Optional: Talent Mapper live PubMed search via NCBI E-utilities (server-side only).
# NCBI_EMAIL is required for live PubMed. NCBI_API_KEY is optional (higher rate limit).
# Create a key: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=""
NCBI_EMAIL=""
NCBI_TOOL="ResumeXTalentMapper"
PUBMED_ENABLED="true"
PUBMED_MAX_RESULTS_PER_QUERY="25"
PUBMED_MAX_TOTAL_RECORDS="150"

# Optional: Ashby ATS export (server-side only). Prefer connecting via /talent/integrations.
# Leave empty until you have a sandbox/org API key. Do not commit real keys.
ASHBY_API_KEY=""

# ATS credential encryption (required for Recruitee / Zoho / Ashby live connections).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATS_CREDENTIAL_ENCRYPTION_KEY=""
ATS_CREDENTIAL_ENCRYPTION_KEY_VERSION="1"

# Zoho Recruit OAuth (server-side only). Required for Zoho connect flow.
ZOHO_RECRUIT_CLIENT_ID=""
ZOHO_RECRUIT_CLIENT_SECRET=""
ZOHO_RECRUIT_REDIRECT_URI="http://localhost:3000/api/talent/integrations/ats/zoho/callback"
ZOHO_RECRUIT_DEFAULT_ACCOUNTS_URL="https://accounts.zoho.com"

# Opt-in live ATS smoke tests (never enable in CI).
ALLOW_LIVE_ATS_TESTS="false"
# RECRUITEE_LIVE_TEST_CONNECTION_ID=""
# ZOHO_LIVE_TEST_CONNECTION_ID=""
# ASHBY_LIVE_TEST_CONNECTION_ID=""

# Optional: Google OAuth login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: job search providers.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
RAPIDAPI_KEY=""

# Optional: weekly digest cron email.
CRON_SECRET=""
RESEND_API_KEY=""

# Optional: Stripe billing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Optional: cross-site links and diagnostics.
NEXT_PUBLIC_RESUMEX_URL="http://localhost:3000"
NEXT_PUBLIC_TALENTX_URL="http://localhost:3001"
RESUMEX_DEBUG_LOGS="false"
